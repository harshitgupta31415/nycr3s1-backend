# Local PostgreSQL connection. DATABASE_URL takes precedence over the Cloud SQL
# settings below. Clear it when using Cloud SQL IAM authentication.
DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/app

# Cloud SQL IAM connection settings. Replace these values when DATABASE_URL is
# empty and the backend should connect through the Cloud SQL Python Connector.
INSTANCE_CONNECTION_NAME=
IAM_DB_USER=
DB_NAME=app

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGIN=http://localhost:3000

# Clerk authentication. Keep real credentials outside source control.
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Keep false for the anonymous opaque-ID hackathon flow. Set true only after
# Clerk credentials and the frontend session integration are configured.
CLERK_AUTH_REQUIRED=false

# Vertex AI configuration. The model ID was verified through the GKE runtime
# identity; none of these values is a secret.
GOOGLE_CLOUD_PROJECT=nychacksishv-core-20260808
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.6-flash

# Disposable PostgreSQL 18 simulator. "auto" uses native binaries first and
# a network-isolated Docker container for local development.
ROLLBACKREADY_SANDBOX_BACKEND=auto
ROLLBACKREADY_POSTGRES_BIN=
ROLLBACKREADY_POSTGRES_IMAGE=postgres:18-alpine
ROLLBACKREADY_STATEMENT_TIMEOUT_MS=5000
ROLLBACKREADY_LOCK_TIMEOUT_MS=2000
ROLLBACKREADY_TOTAL_RUNTIME_SECONDS=90
ROLLBACKREADY_MAX_TOTAL_ROWS=10000
ROLLBACKREADY_MAX_ACTIVE_ANALYSES=25
ROLLBACKREADY_CREATE_RATE_LIMIT_PER_MINUTE=10
ROLLBACKREADY_PERSIST_REPORTS=false
